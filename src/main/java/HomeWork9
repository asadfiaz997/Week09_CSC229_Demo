package Main;

public class homework9 {

	
	

	    public static void main(String[] args) {
	        int n = 1;
	        while (true) {
	            int triangle = n * (n + 1) / 2;
	            int divisors = countDivisors(triangle);
	            if (divisors > 100) {
	                System.out.println("The first triangle number with over 100 divisors is: " + triangle);
	                break;
	            }
	            n++;
	        }
	    }

	    // Method to count the number of divisors of a number
	    public static int countDivisors(int number) {
	        int count = 0;
	        int sqrt = (int) Math.sqrt(number);
	        for (int i = 1; i <= sqrt; i++) {
	            if (number % i == 0) {
	                count += 2; // i and number/i
	            }
	        }
	        if (sqrt * sqrt == number) {
	            count--; // if it's a perfect square, avoid double-counting the sqrt
	        }
	        return count;
	    }
	}

